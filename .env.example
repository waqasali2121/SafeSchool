# SafeAI School - Environment Variables
# "Every Girl Safe. Every Parent Connected. Every Student Empowered."

# Next.js Public
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Credentials (PostgreSQL with pgvector)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Google Gemini API (for live multimodal RAG extension)
GEMINI_API_KEY=your-gemini-api-key

# SMS & WhatsApp Gateway (for production parent dispatches)
WHATSAPP_API_TOKEN=your-whatsapp-business-api-token
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
