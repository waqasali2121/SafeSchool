# ==============================================================================
# SafeAI School – Environment Configuration Template
# Tagline: "Every Girl Safe. Every Parent Connected. Every Student Empowered."
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. SUPABASE (DATABASE, AUTH, STORAGE & PGVECTOR)
# Obtain from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# PostgreSQL Direct Connection URI (for migrations & vector indexes)
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. AI & RAG RETRIEVAL ENGINE
# ------------------------------------------------------------------------------
# Google Gemini API Key (for grounded RAG synthesis & question answering)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional: OpenAI API Key
OPENAI_API_KEY=your-openai-api-key

# ------------------------------------------------------------------------------
# 4. PARENT SAFETY & NOTIFICATION CHANNELS (REAL-TIME BROADCASTS)
# ------------------------------------------------------------------------------
# Meta / WhatsApp Business Cloud API
WHATSAPP_API_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id

# Twilio SMS Gateway
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567

# Resend Email Notification API
RESEND_API_KEY=your-resend-api-key

# ------------------------------------------------------------------------------
# 5. CAMPUS GEOFENCING & EMERGENCY RADAR
# ------------------------------------------------------------------------------
# Google Maps Platform API Key (for Nearby Emergency Services & GPS routing)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Virtual Geofence Coordinates (Default campus center point)
CAMPUS_GEOFENCE_LATITUDE=33.7201
CAMPUS_GEOFENCE_LONGITUDE=73.0612
CAMPUS_GEOFENCE_RADIUS_METERS=500
